// nextflow.config -- plasmid_detection pipeline (stages 1-9 of the sbatch version).
// Tool parameters, env and database paths come from config/config.yaml via
// `nextflow/run.sh` (-params-file); this file holds only run-level options and resources.

params {
    // Input: BioProject, SRA study, or comma-separated runs. Default: Lambirth et al. 2018
    // (Gibas lab), PRJNA415974 / SRP121672, WGS runs only (its 496 16S runs are dropped).
    id                = 'PRJNA415974'
    library_strategy  = 'WGS'
    runs              = null     // optional subset: comma-separated runs or a file, one per line
    // Location/site/timepoint from SRA SampleName (named groups); non-matching runs -> one group
    sample_name_regex = '^Sample_(?P<location>.+?_(?:Creek|Control))_(?P<site>.+)_(?P<timepoint>\\d+)$'

    outdir            = '/scratch/rgupta25/plasmid_detection/results_nf'
    // Downloads are a permanent cache (storeDir): runs already here are never re-fetched
    raw_dir           = '/scratch/rgupta25/plasmid_detection/raw'
    manifest_dir      = '/scratch/rgupta25/plasmid_detection/manifest'

    metaspades        = true     // stage 4: one metaSPAdes attempt on the smallest run
    depth_experiment  = false    // stage 9b/c: opt-in (subsample -> assemble -> geNomad)
}

conda.enabled = true
workDir = '/scratch/rgupta25/plasmid_detection/work_nf'

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [137, 140, 143] && task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries    = 2
    cpus = 2; memory = '8 GB'; time = '4h'

    withLabel: 'local'      { executor = 'local' }
    withName: 'DOWNLOAD_READS'   { cpus = 8;  memory = '16 GB';  time = '12h' }
    withName: 'FASTQC_.*'        { cpus = 8;  memory = '16 GB';  time = '8h' }
    withName: 'FASTP'            { cpus = 8;  memory = '16 GB';  time = '8h' }
    withName: 'HOST_DEPLETION'   { cpus = 16; memory = '32 GB';  time = '12h' }
    withName: 'MEGAHIT'          { cpus = 32; memory = { 128.GB * task.attempt }; time = '2d' }
    withName: 'METASPADES'       { cpus = 32; memory = '500 GB'; time = '3d'; errorStrategy = 'ignore' }
    withName: 'MAP_SYSTEM'       { cpus = 16; memory = '64 GB';  time = '2d' }
    withName: 'ASSEMBLY_QC'      { cpus = 16; memory = '32 GB';  time = '12h' }
    withName: 'SCAPP'            { cpus = 16; memory = '64 GB';  time = '2d' }
    withName: 'GENOMAD'          { cpus = 16; memory = '64 GB';  time = '1d' }
    withName: 'CHECKV_MOBTYPER'  { cpus = 16; memory = '64 GB';  time = '1d' }
    withName: 'AMR'              { cpus = 16; memory = '32 GB';  time = '1d' }
    withName: 'COVERAGE_TAG'     { cpus = 16; memory = '32 GB';  time = '12h' }
    withName: 'BINNING'          { cpus = 16; memory = '64 GB';  time = '1d' }
    withName: 'CHECKM2_MIMAG'    { cpus = 16; memory = '64 GB';  time = '1d' }
    withName: 'DREP'             { cpus = 32; memory = '64 GB';  time = '1d' }
    withName: 'GTDBTK'           { cpus = 32; memory = '256 GB'; time = '2d' }
    withName: 'MAG_ABUNDANCE'    { cpus = 32; memory = '64 GB';  time = '2d' }
    withName: 'MAG_AMR'          { cpus = 16; memory = '32 GB';  time = '1d' }
    withName: 'RGI_BWT'          { cpus = 32; memory = '32 GB';  time = '1d' }
    withName: 'DEPTH_SUBSAMPLE'  { cpus = 32; memory = '128 GB'; time = '2d' }
}

profiles {
    slurm {
        executor {
            name            = 'slurm'
            queueSize       = 20          // at most 20 jobs in the queue at once
            submitRateLimit = '10/1min'
        }
        process.queue = 'Orion'
    }
    local {
        executor.name = 'local'
    }
    // The 4-run pilot: SC_UPB_T4, SC_INF_T4, MC_UPB_T4, MC_INF_T4
    pilot {
        params.runs   = "${projectDir}/../metadata/pilot_samples.txt"
        params.outdir = '/scratch/rgupta25/plasmid_detection/results_nf_pilot'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }

manifest {
    name            = 'plasmid_detection'
    description     = 'Plasmid and AMR detection in shotgun metagenomes (PRJNA415974 by default)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04'
}
